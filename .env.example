# Copy to .env (never commit .env) and fill in real values.
COUCHDB_URL = "http://127.0.0.1:5984/"
COUCHDB_USER = "admin"
COUCHDB_PASSWORD = "change-me"
COUCHDB_NAME = "counselling_db"

# Django
DJANGO_SECRET_KEY = "generate-a-long-random-string"
DJANGO_DEBUG = "true"
DJANGO_ALLOWED_HOSTS = "127.0.0.1,localhost"
# Seconds a sign-in token stays valid (default 8 hours)
AUTH_TOKEN_MAX_AGE = "28800"
# Only needed for a separately hosted frontend, e.g. "http://localhost:5173"
CORS_ALLOWED_ORIGINS = ""
