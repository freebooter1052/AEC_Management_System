# Copy to .env (never commit .env) and fill in real values.
COUCHDB_URL = "http://127.0.0.1:5984/"
COUCHDB_USER = "admin"
COUCHDB_PASSWORD = "change-me"
COUCHDB_NAME = "counselling_db"

# Django
DJANGO_SECRET_KEY = "generate-a-long-random-string"
DJANGO_DEBUG = "true"
DJANGO_ALLOWED_HOSTS = "127.0.0.1,localhost"
# Seconds a sign-in token stays valid (default 8 hours)
AUTH_TOKEN_MAX_AGE = "28800"
# Forgot-password emails. Leave EMAIL_HOST empty in development: the 6-digit code is then
# printed in the `runserver` console instead of being emailed. For Gmail use an App Password
# (Google Account > Security > 2-Step Verification > App passwords), not your normal password.
EMAIL_HOST = ""
# EMAIL_HOST = "smtp.gmail.com"
# EMAIL_PORT = "587"
# EMAIL_HOST_USER = "you@gmail.com"
# EMAIL_HOST_PASSWORD = "your-16-character-app-password"
# DEFAULT_FROM_EMAIL = "AEC Admissions <you@gmail.com>"
# SOP & LOR writing assistant (Google Gemini). Get a key at https://aistudio.google.com/apikey.
# Leave empty to switch AI drafting off; counsellors can still write and track SOPs and referees by hand.
GEMINI_API_KEY = ""
# GEMINI_MODEL = "gemini-3.8-flash"
# Only needed for a separately hosted frontend, e.g. "http://localhost:5173"
CORS_ALLOWED_ORIGINS = ""
